            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Monitor piscando\",\n  \"descricao\": \"O monitor pisca a cada poucos segundos.\",\n  \"categoria\": 1,\n  \"prioridade\": \"alta\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.id) { pm.collectionVariables.set('chamado_id', j.id); }",
                  "pm.test('Criado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Abrir chamado (payload inválido -> 400)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chamados/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chamados"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"ab\",\n  \"descricao\": \"x\",\n  \"categoria\": 999\n}"
            }
          }
        },
        {
          "name": "Listar chamados",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chamados/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chamados"
              ]
            }
          }
        },
        {
          "name": "Listar com filtros",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chamados/?status=aberto&prioridade=alta&q=monitor",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chamados",
                "?status=aberto&prioridade=alta&q=monitor"
              ]
            }
          }
        },
        {
          "name": "Detalhe do chamado",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chamados/{{chamado_id}}/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chamados",
                "{{chamado_id}}"
              ]
            }
          }
        },
        {
          "name": "Comentar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chamados/{{chamado_id}}/comentarios/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chamados",
                "{{chamado_id}}",
                "comentarios"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"texto\": \"Mais informações: acontece após ligar o PC.\",\n  \"interno\": false\n}"
            }
          }
        },
        {
          "name": "Anexar arquivo",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Token {{token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/chamados/{{chamado_id}}/anexos/",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "chamados",
                "{{chamado_id}}",
                "anexos"
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        }
      ]
    },
    {
