# Copie este arquivo para ".env" e ajuste os valores.
SECRET_KEY=troque-esta-chave-em-producao
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Banco de dados: "sqlite" (padrão, desenvolvimento) ou "postgres"
DB_ENGINE=sqlite

# Parâmetros de conexão ao PostgreSQL (local ou remoto)
DB_NAME=helpdesk
DB_USER=helpdesk_user
DB_PASSWORD=helpdesk_pass
DB_HOST=localhost
DB_PORT=5432
# Para conexões remotas use "require" (SSL obrigatório); local use "prefer"
DB_SSLMODE=prefer
# Notificações por e-mail (padrão: imprime no terminal). Para SMTP real:
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.exemplo.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=usuario
# EMAIL_HOST_PASSWORD=senha
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=helpdesk@suaempresa.com
